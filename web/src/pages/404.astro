---
import { withBase } from "../lib/site";
import Base from "../layouts/Base.astro";
---

<Base title="Not found — deckport" description="That page doesn't exist.">
  <section class="section">
    <div class="wrap" style="text-align:center;padding:4rem 0 5rem;">
      <p class="eyebrow">404</p>
      <h1 style="margin:0.2rem 0 1rem;">That page got delisted.</h1>
      <p class="muted" style="max-width:520px;margin:0 auto 1.75rem;">
        The page you're after isn't here — it may have moved, or never existed.
        The recipe book is still where you left it.
      </p>
      <div class="btn-row" style="justify-content:center;">
        <a class="btn primary" href={withBase("/recipes")}>Browse the recipe book</a>
        <a class="btn" href={withBase("/")}>Home</a>
      </div>
    </div>
  </section>
</Base>
